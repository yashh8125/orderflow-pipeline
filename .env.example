# Copy to .env and change the password. .env is git-ignored.
POSTGRES_USER=orderflow
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=orderflow

# Match your host user so the container can write ./data and ./reports (run `id -u` / `id -g`).
APP_UID=1000
APP_GID=1000

# Optional: upload reports to S3 (needs AWS credentials or an IAM role).
S3_BUCKET=
